# ---- Site ----------------------------------------------------------------
# Production domain — canonical URLs, OG tags and sitemap derive from this.
# Optional: the code already defaults to https://www.mintimotorsports.com.
NEXT_PUBLIC_SITE_URL=https://www.mintimotorsports.com

# ---- Contact (optional overrides — sensible defaults are built in) ---------
# Defaults: mintimotorsports@gmail.com / +254 799 839012 / 254799839012
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only, international format, e.g. 2547XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Calendly/SavvyCal etc. — enables the optional book-a-call step after enquiry
NEXT_PUBLIC_BOOKING_URL=

# ---- Lead delivery (configure at least one before launch — see README) ----
# Any endpoint that accepts a JSON POST (Zapier, Make, your own API)
LEAD_WEBHOOK_URL=
# Email via Resend. With RESEND_API_KEY set, enquiries are emailed to
# LEAD_TO_EMAIL (default mintimotorsports@gmail.com) from LEAD_FROM_EMAIL
# (default onboarding@resend.dev — replace once the site domain is
# verified in Resend).
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# ---- Analytics (optional — nothing loads when unset) -----------------------
# Plausible: cookieless, no consent banner shown
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# GA4: loads only after the visitor accepts the consent banner
NEXT_PUBLIC_GA_ID=
