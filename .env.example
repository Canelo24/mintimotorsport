# ---- Site ----------------------------------------------------------------
# Production domain — canonical URLs, OG tags and sitemap derive from this.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Contact (all optional — UI elements stay hidden / show TBC until set) -
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only, international format, e.g. 2547XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Calendly/SavvyCal etc. — enables the optional book-a-call step after enquiry
NEXT_PUBLIC_BOOKING_URL=

# ---- Lead delivery (configure at least one before launch — see README) ----
# Any endpoint that accepts a JSON POST (Zapier, Make, your own API)
LEAD_WEBHOOK_URL=
# Email via Resend
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# ---- Analytics (optional — nothing loads when unset) -----------------------
# Plausible: cookieless, no consent banner shown
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# GA4: loads only after the visitor accepts the consent banner
NEXT_PUBLIC_GA_ID=
